# Copy to terraform.tfvars (gitignored) and adjust.
#
# Almost every value here is an address-plan decision, and most of them are
# ForceNew. Read docs/design.md before changing a prefix or a region key.

name_prefix = "scandula"
location    = "eastasia" # control plane: RGs, network manager, root pool, vWAN, firewall policy

ipam_root_prefix = "10.64.0.0/12" # 10.64.0.0 – 10.79.255.255

# On-premises ranges the root must never overlap. Empty by default; fill in before
# connecting anything over VPN or ExpressRoute.
# reserved_prefixes = ["192.168.0.0/16"]

# Azure Policy: no VNet under this management group may overlap reserved_prefixes.
# Off until management_group_id is set. It reaches every VNet under the management
# group, so only with its policy owner's agreement, and needs Resource Policy
# Contributor there. Keep Audit until its findings are reviewed.
# onprem_policy = {
#   management_group_id = "/providers/Microsoft.Management/managementGroups/<name>"
#   effect              = "Audit" # or "Deny"
# }

# Azure Policy: VNets in a migrated scope must take their space from the region
# pools. Define it once, then add each scope as it migrates. NEVER the landing-zone
# root while VNets outside AVNM live under it. Keep Audit until its findings are
# reviewed.
# avnm_allocation_policy = {
#   management_group_id = "/providers/Microsoft.Management/managementGroups/<name>"
#   assignments = {
#     corp = { scope = "/providers/Microsoft.Management/managementGroups/<migrated mg>" }
#     app1 = { scope = "/subscriptions/<id>", effect = "Deny", not_scopes = [] }
#   }
# }

# Each region gets an IPAM pool, and — when secured_vwan_enabled — a secured hub on
# hub_address_prefix, which is reserved in that pool either way.
#
# East Asia + Southeast Asia: an Azure region pair, both with availability zones.
# Chosen to avoid capacity contention: UK South exposes no VM sizes at all to the
# Visual Studio subscription. See docs/design.md#regions.
regions = {
  eas = {
    location           = "eastasia"
    address_prefix     = "10.64.0.0/14"
    hub_address_prefix = "10.64.0.0/23"
  }
  sea = {
    location           = "southeastasia"
    address_prefix     = "10.68.0.0/14"
    hub_address_prefix = "10.68.0.0/23"
  }
}

# What the hub firewall allows. Nothing, until it's named here (docs/zero-trust.md).
# Validations refuse "Any" protocols, "*" ports and a bare "*" FQDN, so a rule can't
# quietly widen back into the blanket pair this replaced.
# east_west_flows = {
#   app1-to-sql = {
#     description  = "app1 (eas) to the SQL MI (sea). Asked for by the app1 team, 2026-09-14."
#     sources      = ["10.64.1.0/24"]
#     destinations = ["10.68.2.0/24"]
#     protocols    = ["TCP"]
#     ports        = ["1433"]
#   }
# }
# egress_https_fqdns = ["login.microsoftonline.com", "*.ubuntu.com"]
# egress_http_fqdns  = ["ocsp.digicert.com"]   # certificate revocation only
# egress_fqdn_tags   = ["WindowsUpdate"]

# The hub firewalls' logs. On by default with the hubs; ingestion is the cost.
# firewall_diagnostics_enabled = true
# log_retention_days           = 30

# ⚠ COST. Two secured hubs (Standard hub + Basic firewall) are about $942/month
# before data processing. On a Visual Studio credit subscription that runs out in
# under two days and the subscription is disabled. Leave this false there.
secured_vwan_enabled = false
firewall_sku_tier    = "Basic"

# Reserve blocks that live outside AVNM's view, e.g. a P2S VPN client pool.
# Keep them out of every region pool.
# root_static_cidrs = {
#   p2s-clients = ["10.79.255.0/24"]
# }

# Leave empty to scope AVNM to the subscription you're running against.
# network_manager_scope = {
#   management_group_ids = ["/providers/Microsoft.Management/managementGroups/<name>"]
# }

# tags = {
#   environment = "prod"
# }

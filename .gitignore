# Terraform
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraformrc
terraform.rc
*.tfplan
tfplan
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — commit it once it has
# been generated by HashiCorp Terraform (`make lock`). An OpenTofu-generated one
# records registry.opentofu.org and is useless to `terraform init`.

# Variable + backend files carry tenant/subscription ids and the state account
# name — only their .example siblings are committed.
terraform.tfvars
*.auto.tfvars
backend.hcl
.env
.env.local

# Azure IPAM wrapper workspace: the upstream clone, the release zip, and
# main.parameters.json, which holds the engine app registration's client secret.
azure-ipam/.work/
main.parameters.json

# Keys that stray in
*.pem
*.key
*.p8
*.pfx

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: project settings are shared, local overrides are not
.claude/settings.local.json

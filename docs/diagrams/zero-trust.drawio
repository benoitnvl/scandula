<mxfile host="drawio">
  <diagram id="scandula-zero-trust" name="zero-trust layers">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="720" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="scandula: zero-trust enforcement layers (docs/zero-trust.md)" style="text;html=0;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="820" height="36" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="1  ·  Azure Policy guardrails&#xa;every subnet has an NSG  ·  no public IPs on workload NICs&#xa;no 0.0.0.0/0 route around the firewall  ·  PaaS reachable privately" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=12;fontColor=#1f2937;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="PLAN  ·  step 3&#xa;built-ins, plus one custom rule:&#xa;no built-in covers bypass routes" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=11;fontColor=#78350f;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="290" height="74" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="2  ·  AVNM security admin rules&#xa;deny 22 / 3389 from the internet  ·  deny spoke ↔ spoke by default&#xa;evaluated BEFORE NSGs: a workload owner cannot override them" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=12;fontColor=#1f2937;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="174" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="PLAN  ·  step 4&#xa;needs scope_accesses += SecurityAdmin&#xa;replaces the deprecated RDP/SSH built-ins" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=11;fontColor=#78350f;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="174" width="290" height="74" as="geometry" />
        </mxCell>

        <mxCell id="l3" value="3  ·  NSG + ASG inside each spoke&#xa;the last hop, per subnet and per workload" style="rounded=1;html=0;dashed=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=12;fontColor=#111827;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="278" width="600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="OWNED BY THE WORKLOAD REPOS&#xa;layer 1 makes them compulsory" style="rounded=1;html=0;dashed=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=11;fontColor=#111827;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="278" width="290" height="58" as="geometry" />
        </mxCell>

        <mxCell id="l4" value="4  ·  Hub Azure Firewall  ·  afwp-scandula&#xa;DENY BY DEFAULT. Only the flows named in east_west_flows and&#xa;the destinations named in egress_*  ·  no inbound DNAT&#xa;routing intent forces private AND internet traffic through it" style="rounded=1;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontStyle=1;fontColor=#064e3b;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="366" width="600" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="BUILT  ·  2026-09-14 (#23)&#xa;infra/firewall-rules.tf&#xa;validations refuse &quot;Any&quot;, &quot;*&quot; ports and a bare *" style="rounded=1;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontColor=#064e3b;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="366" width="290" height="86" as="geometry" />
        </mxCell>

        <mxCell id="l5" value="5  ·  Inspection: IDPS and TLS inspection&#xa;Basic cannot inspect what it allows: an allow-list is only as&#xa;strong as SNI without it" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=12;fontColor=#1f2937;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="482" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="PLAN  ·  step 5  ·  Aberdeen's call&#xa;Premium ≈ $1,540 per hub per month&#xa;(Basic ≈ $471, Standard ≈ $1,146)" style="rounded=1;html=0;dashed=1;fillColor=#fff8ec;strokeColor=#b7791f;fontSize=11;fontColor=#78350f;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="482" width="290" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l6" value="Visibility  ·  log-scandula-hub&#xa;both hub firewalls: allLogs → AZFW* tables, plus metrics" style="rounded=1;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontColor=#064e3b;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="582" width="600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="BUILT  ·  2026-09-14 (#23)&#xa;infra/diagnostics.tf  ·  30 days&#xa;without it, none of the above is verifiable" style="rounded=1;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontColor=#064e3b;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="582" width="290" height="58" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="endArrow=block;html=0;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="endArrow=block;html=0;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2" target="l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="endArrow=block;html=0;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="needs Premium" style="endArrow=block;html=0;dashed=1;strokeColor=#b7791f;fontSize=11;fontColor=#78350f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4" target="l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e46" value="logs, today" style="endArrow=block;html=0;dashed=1;strokeColor=#047857;fontSize=11;fontColor=#064e3b;labelBackgroundColor=#ffffff;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4" target="l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="Anything not named at layer 4 is denied. Layers 1, 2 and 5 need Aberdeen: who owns NSGs, what the landing zones already assign, and whether inspection is funded." style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="20" y="656" width="920" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

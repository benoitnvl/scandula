        <mxCell id="e-res-eas" value="reserved for the hub" style="endArrow=block;html=0;dashed=1;dashPattern=2 3;strokeColor=#0369a1;fontSize=11;fontColor=#0c4a6e;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-eas" target="hub-eas">
          <mxGeometry relative="1" as="geometry" />
